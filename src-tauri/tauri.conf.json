{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniWall",
  "version": "0.1.0",
  "identifier": "io.github.aniwall",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AniWall · KDE 动态壁纸管理器",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "KDE 动态壁纸管理器",
    "longDescription": "AniWall 是一个为 KDE Plasma 6 设计的视频/动态壁纸管理器：从 Bilibili 等站点下载、解析并管理壁纸，调用 Smart Video Wallpaper Reborn 插件一键应用到桌面。仅在 CachyOS 上测试过。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
